        android:name=".BucklerApp"
        android:allowBackup="false"
        android:banner="@drawable/banner_buckler"
        android:icon="@drawable/ic_mark_buckler"
        android:roundIcon="@drawable/ic_mark_buckler"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BucklerHome"
        android:usesCleartextTraffic="false">

        <activity
