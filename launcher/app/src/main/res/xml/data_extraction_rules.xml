<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves this TV in a cloud backup or a device-to-device transfer: Buckler's preferences
     hold account tokens and its adb key. (allowBackup="false" alone doesn't cover transfers on
     Android 12 and later.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
