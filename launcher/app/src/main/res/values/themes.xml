<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BucklerHome" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#FF0B0E14</item>
        <item name="android:colorPrimary">#FFD4A84B</item>
    </style>
    <!-- Buckler Settings: a panel sliding in over whatever is on screen, as SHIELD's own settings do. -->
    <style name="Theme.BucklerHome.Panel">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
