{
  "schema": 1,
  "widgets": [
    {
      "id": "news",
      "label": "News",
      "about": "Headlines from the sources you pick, one story at a time.",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "now_playing",
      "label": "Now Playing",
      "about": "The song or show playing on the TV, with its artwork and controls.",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "lyrics",
      "label": "Lyrics",
      "about": "Time-synced lyrics for the song playing, karaoke style.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "weather",
      "label": "Weather",
      "about": "Today and the days ahead for your city (Open-Meteo).",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "suggested",
      "label": "Suggested",
      "about": "Things to watch from your apps' own recommendations.",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "glance",
      "label": "At a Glance",
      "about": "The next thing on your calendar, reminders and the weather in one line.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "calendar",
      "label": "Calendar",
      "about": "The next few days side by side, with reminders, from the calendars the TV syncs.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "weather_map",
      "label": "Weather map",
      "about": "A live map around your city: pressure lines with highs and lows, wind and rain.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "companion",
      "label": "Companion",
      "about": "A little animated friend that reacts to the time and weather.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "multiview",
      "label": "Multiview",
      "about": "Several live streams side by side.",
      "default": false,
      "since": "0.21.0"
    },
    {
      "id": "comics",
      "label": "Comics",
      "about": "Public-domain newspaper strips, cleaned up, with a reader to zoom panel by panel.",
      "default": false,
      "since": "0.23.0"
    },
    {
      "id": "spurious",
      "label": "Spurious correlations",
      "about": "Two unrelated things that rose and fell together, from Tyler Vigen's charts.",
      "default": false,
      "since": "0.23.0"
    }
  ],
  "screensavers": [
    {
      "id": "saver_clock",
      "label": "Drifting clock",
      "about": "A large clock that glides to a new spot now and then, so nothing burns in.",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "saver_dvd",
      "label": "DVD bounce",
      "about": "The Buckler mark and the clock bounce around, changing colour on every edge.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "saver_photos",
      "label": "Photos (online)",
      "about": "Featured pictures from Wikimedia Commons in the categories you pick, credited on screen.",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "saver_uploaded",
      "label": "My photos",
      "about": "A slideshow of photos you upload from your phone.",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "saver_now_playing",
      "label": "Now Playing",
      "about": "Whatever is playing, large, with its artwork; a clock when nothing plays.",
      "default": true,
      "since": "0.1.0"
    },
    {
      "id": "saver_maze",
      "label": "3D Maze",
      "about": "A walk through brick, stone or wood mazes, after Windows 95's 3D Maze, with gems that flip the view, the Buckler mark at each exit and the odd night walk.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "saver_pipes",
      "label": "3D Pipes",
      "about": "Pipes grow and twist through 3D space, after the Windows 3D Pipes.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "saver_mystify",
      "label": "Mystify",
      "about": "Bouncing, colour-shifting outlines with trails, after Windows Mystify.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "saver_starfield",
      "label": "Starfield",
      "about": "Flying through a field of stars, after Windows Starfield.",
      "default": false,
      "since": "0.1.0"
    },
    {
      "id": "saver_weather",
      "label": "Rolling weather",
      "about": "The weather in turn - now, the next hours and days, the pressure map and a heat map.",
      "default": false,
      "since": "0.23.0"
    }
  ],
